/* Global Styles */
* {
    font-family: "Segoe UI", Geneva, Verdana, sans-serif;
    font-size: 10pt;
    margin: 0;
    padding: 0;
}

QWidget {
    background-color: #f0f0f0; /* Light background */
    color: #333333; /* Text color */
}

/* Button Styles */
QPushButton {
    background-color: #0078d4; /* Primary color */
    color: white;
    border-radius: 5px;
    padding: 8px 16px;
    border: none;
}

/* Combo Box Styles */
QComboBox {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 5px;
    padding: 5px;
    min-width: 120px;
    color: #333333;
}

QComboBox:editable {
    background-color: #f9f9f9; /* Light background for editable */
}

QComboBox:focus {
    border: 1px solid #0078d4; /* Highlight border when focused */
}

QComboBox:hover {
    border: 1px solid #0078d4; /* Hover effect */
}

QComboBox QAbstractItemView {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 5px;
    color: #333333;
    selection-background-color: #0078d4; /* Highlight selected item */
    selection-color: white;
}

/* QMenu Styles */
QMenu {
    background-color: white;
    border: 1px solid #cccccc;
    border-radius: 5px;
    color: #333333;
    min-width: 160px;
}

QMenu::item {
    padding: 4px 8px;
    border-radius: 4px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #0078d4; /* Primary color on selection */
    color: white;
}

QMenu::item:hover {
    background-color: #e1e1e1; /* Light hover effect */
    color: #0078d4;
}

/* Tooltip Styles */
QToolTip {
    background-color: #333333;
    color: white;
    border-radius: 4px;
    padding: 5px;
}

/* Global Styles for the Toolbar */
QToolBar {
    background-color: #f0f0f0; /* Light background */
    border: none;
    spacing: 5px;
    padding: 3px;
    border-radius: 4px;
}

/* Toolbar Button Styles */
QToolButton {
    background-color: transparent;
    border: none;
    color: #333333;
    padding: 5px;
    margin: 2px;
    border-radius: 3px;
    icon-size: 20px;
}

QToolButton:disabled {
    color: #bbbbbb;
    background-color: transparent;
}

QToolButton:hover {
    background-color: #e1e1e1; /* Light hover effect */
    border-radius: 5px;
}

QToolButton:pressed {
    background-color: #c9c9c9; /* Darker pressed effect */
    border-radius: 5px;
}

/* Active State for Toolbar Buttons */
QToolButton:checked {
    background-color: #0078d4; /* Primary color for active state */
    color: white;
    border-radius: 5px;
}

/* Separator between Toolbar Buttons */
QToolBar::separator {
    background-color: #d0d0d0;
    width: 1px;
    margin: 5px;
}

/* Customizing the icons on hover */
QToolButton:hover {
    background-color: #d4d4d4; /* Hover for the button */
    border-radius: 5px;
    color: #0078d4; /* Hover text color */
}

/* Active State for the button */
QToolButton:checked {
    background-color: #005f9e; /* Darker primary color when active */
    color: white;
    border-radius: 5px;
}
